# ═══════════════════════════════════════════════════════════════════
#  MediLink AI — Environment Variables TEMPLATE
#  Copy this file to `.env.local` and fill in the real values:
#      cp .env.example .env.local
#  Never commit real secrets. Values are loaded by Next.js
#  automatically for `next dev` / `next build` / `next start`.
# ═══════════════════════════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────────────────
# OpenRouter API keys — powers the "Dr MediLink" chatbot
# Get keys at: https://openrouter.ai/settings/keys
# Multiple keys enable automatic rotation when one hits rate limits (429) or quota (402).
# At least one key is required. Up to 5 keys supported (OPENROUTER_API_KEY_1 through _5).
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# Legacy single key (deprecated but kept for backward compatibility).
# If set and no OPENROUTER_API_KEY_1 is provided, this key will be used.
OPENROUTER_API_KEY=

# ── OPTIONAL ─────────────────────────────────────────────────────
# MediLink WhatsApp number used by pharmacy orders and SOS sharing.
# Digits only, with country code, no "+" and no spaces.
# Defaults to 8801811389672 when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801811389672

# Per-IP rate limit for /api/chat: max requests per minute (default 12).
# Keeps the free-model demo stable against burst traffic.
CHAT_RATE_LIMIT_PER_MIN=12

# ── API Key Rotation (optional but recommended) ───────────────────
# Upstash Redis for persistent quota tracking across deployments/instances.
# Get credentials at: https://console.upstash.com/redis
# When unset, quota tracking falls back to in-memory (resets on redeploy).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Daily quota per OpenRouter key (default 1000). Adjust per your OpenRouter tier.
# OPENROUTER_DAILY_QUOTA_PER_KEY=1000

# ═══════════════════════════════════════════════════════════════════
#  v3 FEATURE PACK — Vision / OCR, Maps, WhatsApp Business, Web Push
# ═══════════════════════════════════════════════════════════════════

# ── Vision / OCR (image understanding only) ───────────────────────
# Primary OCR model: MiniMax M3.1 Flash (free tier).
# The text-chat models are configured separately in model-router.ts —
# changing these values can never change a chat answer.
VISION_MODEL_ID=minimax/minimax-m3.1-flash:free

# OpenAI-compatible gateway that serves the vision model.
VISION_BASE_URL=https://openrouter.ai/api/v1

# Key for the vision gateway. Falls back to OPENROUTER_API_KEY when unset.
VISION_API_KEY=

# Fallback model. Used for 404 (model retired), 429 (quota), timeouts,
# 5xx and output that cannot be parsed as JSON. Auth errors are fatal
# and are never retried on another model.
VISION_FALLBACK_MODEL_ID=nvidia/nemotron-3.5-super-vl:free

# Max vision calls per hour per IP (default 60).
VISION_RATE_LIMIT_PER_HOUR=60

# ── Google Maps ────────────────────────────────────────────────────
# SERVER-ONLY key. Enables the Routes, Directions and Geocoding APIs.
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser.
# Enable "Routes API" and "Directions API" in the Google Cloud console.
GOOGLE_MAPS_API_KEY=

# Default travel mode for hospital routing (DRIVE|WALK|BICYCLE|TWO_WHEELER).
GOOGLE_MAPS_TRAVEL_MODE=DRIVE

# ── OSRM routing (default provider — no key, no billing) ──────────
# Real road distance and driving time for the emergency hospital list.
# Leave unset to use the public demo server. For production, self-host
# with the Bangladesh OSM extract and point this at your container.
# HONESTY: OSRM has no live-traffic data. The UI says "driving".
OSRM_BASE_URL=https://router.project-osrm.org

# OSRM profile: driving | walking | cycling.
# Note: the public demo server only serves the car profile.
OSRM_PROFILE=driving

# ── WhatsApp Business API (optional, v3.1) ────────────────────────
# v2 uses plain wa.me deep links and needs none of these.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_DOCTOR_BOOKING=doctor_booking

# ── Web Push (optional, v3.1) ─────────────────────────────────────
# Needed only for reliable background delivery when the app is closed.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:dev@medilink.com.bd
